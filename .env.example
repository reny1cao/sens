# Sens Project Environment Configuration
# ===================================

# Core Settings
# ------------
SENS_ENVIRONMENT=development  # Options: development, staging, production

# Logging Configuration
# -------------------
SENS_LOG_FORMAT=pretty       # Options: json (production) or pretty (development)
SENS_LOG_LEVEL=DEBUG        # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENS_LOG_COLORS=true        # Enable colors for pretty format (true/false)

# Database Configuration
# --------------------
SENS_DB_HOST=localhost
SENS_DB_PORT=5432
SENS_DB_NAME=postgres
SENS_DB_USER=postgres
SENS_DB_PASSWORD=your_secure_password

# OpenRouter Configuration
# ----------------------
SENS_OPENROUTER_API_KEY=sk-your-api-key
SENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SENS_OPENROUTER_REFERER=https://github.com/your-org/sens
SENS_OPENROUTER_TITLE=Sens Project

# File Paths
# ---------
SENS_SCHEMA_PATH=/path/to/schema_metadata.json
SENS_LLM_SCHEMA_PATH=/path/to/schema_for_llm.txt
SENS_INDEX_DIR=/path/to/indices

# API Security
# -----------
SENS_CORS_ORIGINS=*                 # Comma-separated list or * for all
SENS_CORS_METHODS=GET,POST,PUT      # Comma-separated list of allowed methods
SENS_CORS_HEADERS=*                 # Comma-separated list or * for all
SENS_RATE_LIMIT_REQUESTS=100        # Maximum requests per window
SENS_RATE_LIMIT_WINDOW=60          # Rate limit window in seconds

# Model Configurations
# ------------------
# SQL Generator
SENS_SQL_GENERATOR_PRIMARY_MODEL=openai/gpt-4o
SENS_SQL_GENERATOR_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
SENS_SQL_GENERATOR_MAX_TOKENS=500
SENS_SQL_GENERATOR_TEMPERATURE=0.1
SENS_SQL_GENERATOR_TIMEOUT_SECONDS=30

# Intent Extractor
SENS_INTENT_EXTRACTOR_PRIMARY_MODEL=openai/gpt-4o
SENS_INTENT_EXTRACTOR_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
SENS_INTENT_EXTRACTOR_MAX_TOKENS=300
SENS_INTENT_EXTRACTOR_TEMPERATURE=0.2
SENS_INTENT_EXTRACTOR_TIMEOUT_SECONDS=30
SENS_INTENT_EXTRACTOR_CONFIDENCE_THRESHOLD=0.75

# Response Builder
SENS_RESPONSE_BUILDER_PRIMARY_MODEL=openai/gpt-4o
SENS_RESPONSE_BUILDER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
SENS_RESPONSE_BUILDER_MAX_TOKENS=300
SENS_RESPONSE_BUILDER_TEMPERATURE=0.3
SENS_RESPONSE_BUILDER_TIMEOUT_SECONDS=30

# Debug Settings
# ------------
SENS_DEBUG=false                    # Enable debug mode
