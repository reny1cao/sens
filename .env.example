# Required Settings
# ----------------
# The only required setting is the OpenRouter API key
SENS_OPENROUTER_API_KEY=

# OpenRouter Configuration
# -----------------------
SENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SENS_OPENROUTER_REFERER=https://github.com/your-org/sens
SENS_OPENROUTER_TITLE=Sens Project

# SQL Generator Configuration
# --------------------------
SENS_SQL_GENERATOR__PRIMARY_MODEL=openai/gpt-4o-mini
SENS_SQL_GENERATOR__FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
SENS_SQL_GENERATOR__MAX_TOKENS=500
SENS_SQL_GENERATOR__TEMPERATURE=0.1
SENS_SQL_GENERATOR__TIMEOUT_SECONDS=30

# Intent Extractor Configuration
# -----------------------------
SENS_INTENT_EXTRACTOR__PRIMARY_MODEL=openai/gpt-4o-mini
SENS_INTENT_EXTRACTOR__FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
SENS_INTENT_EXTRACTOR__CONFIDENCE_THRESHOLD=0.75
SENS_INTENT_EXTRACTOR__MAX_TOKENS=300
SENS_INTENT_EXTRACTOR__TEMPERATURE=0.2
SENS_INTENT_EXTRACTOR__TIMEOUT_SECONDS=30

# Core Data Settings
# -----------------
SENS_SCHEMA_PATH=src/sens/data/schemas/metadata/schema_metadata.json
SENS_INDEX_DIR=var/indices

# API Security Settings
# -------------------
SENS_CORS_ORIGINS=*
SENS_CORS_METHODS=*
SENS_CORS_HEADERS=*
SENS_RATE_LIMIT_REQUESTS=100
SENS_RATE_LIMIT_WINDOW=60

# Environment Settings
# ------------------
SENS_DEBUG=false
SENS_ENVIRONMENT=development
SENS_LOG_LEVEL=INFO

# Database Settings (for tests)
# ---------------------------
SENS_DB_HOST=localhost
SENS_DB_PORT=5432
SENS_DB_NAME=netflixdb
SENS_DB_USER=postgres
SENS_DB_PASSWORD=123
