# Production Environment Variables for Railway
# Update these values with your actual credentials

# Core Settings
SENS_ENVIRONMENT=production

# Database (Railway provides these automatically)
SENS_DB_HOST=${{PGHOST}}
SENS_DB_PORT=${{PGPORT}}
SENS_DB_NAME=${{PGDATABASE}}
SENS_DB_USER=${{PGUSER}}
SENS_DB_PASSWORD=${{PGPASSWORD}}

# Redis (Railway provides these automatically)
SENS_REDIS_URL=${{REDIS_URL}}

# OpenRouter API (REQUIRED - Add your key)
SENS_OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
SENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage Configuration for Cloudflare R2
SENS_STORAGE_TYPE=r2
SENS_STORAGE_BUCKET=sens-uploads
SENS_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
SENS_STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY
SENS_STORAGE_SECRET_KEY=YOUR_R2_SECRET_KEY
SENS_STORAGE_REGION=auto

# API Security
SENS_CORS_ORIGINS=https://sens-web.vercel.app,http://localhost:3000
SENS_RATE_LIMIT_REQUESTS=100
SENS_RATE_LIMIT_WINDOW=60

# Logging
SENS_LOG_FORMAT=json
SENS_LOG_LEVEL=INFO